.pio
# PlatformIO regenerates these with absolute toolchain paths, so they are machine-specific.
# `.vscode/launch.json` used to be listed here for the same reason, but the hand-written
# repository-wide one is how anyone runs RouterRS, RouterReports and PortalFlasher -- it is
# documentation, not machine state. The generated per-project ones under PortalFW/.vscode and
# HomeSwitchTest/.vscode are still untracked and stay that way.
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/ipch

docs/
**/.vs/

*.depend
*.layout
*.mode*v3
*.pbxuser
*.app*
*.DS_*
._*.*

.svn/
obj/
bin/
build/
!data/
xcuserdata/

ipch/
*.suo
*.opensdf
*.vcxproj.user

*.obj
*.tlog
*.sdf
*.pdb
*.idb
*.pch
Debug/
Release/


*~.xml

.visualgdb
*.vgdbsettings.*.user
Router/enc_temp_folder/

# Raw bench scan captures (kept local - see HomeSwitchTest/reports for curated data)
/scans/

# Python / Node artefacts
__pycache__/
.venv/
node_modules/

# Generated by PortalFW/set_build_date.py before every build. Tracking it meant every build
# dirtied the tree, which then made the next build stamp itself dirty -- permanently, for a
# reason with nothing to do with the source.
PortalFW/src/Version.h

# Built packages. `tools/package.mjs` writes here; a 150 MB zip carrying a CEF framework is a
# build output, and the thing that makes it reproducible is the pinned platform versions and the
# commit recorded in its own MANIFEST.md, not the archive being in git.
/dist/
