{
  // Build tasks referenced by .vscode/launch.json.
  //
  // Each Rust project here is its own Cargo workspace (RouterRS, PortalTestBench), so every task
  // uses a project-specific manifest or build script and an explicit working directory.
  "version": "2.0.0",
  "tasks": [
    {
      // This script deliberately builds the web bundle before Rust so web_assets! embeds the
      // current UI rather than the previous bundle.
      "label": "Portal Test Bench: build",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "tools/build.ps1"
      ],
      "options": { "cwd": "${workspaceFolder}/PortalTestBench" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Portal Test Bench: test",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "tools/test.ps1"
      ],
      "options": { "cwd": "${workspaceFolder}/PortalTestBench" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      // The framework's own structural conformance check for a downstream operator app.
      "label": "Portal Test Bench: check-av-app",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "third_party/av-frameworks/tools/check-av-app.ps1",
        "-AppPath",
        "."
      ],
      "options": { "cwd": "${workspaceFolder}/PortalTestBench" },
      "problemMatcher": []
    },
    {
      // Compiles the real msgpack-arduino sources on the non-Arduino path the RS485 bootloader
      // uses, and replays FWUpdateApp::processIncoming's parse over every frame offset of a full
      // application bank. Needs MSVC; no board, no PlatformIO.
      "label": "Bootloader: native protocol tests",
      "type": "shell",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "run.ps1"],
      "options": { "cwd": "${workspaceFolder}/PortalBootloader/test-native" },
      "problemMatcher": []
    },
    {
      "label": "RouterRS: cargo build",
      "type": "process",
      "command": "cargo",
      "args": ["build", "--manifest-path", "${workspaceFolder}/RouterRS/Cargo.toml", "--workspace"],
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "RouterRS: cargo test",
      "type": "process",
      "command": "cargo",
      "args": ["test", "--manifest-path", "${workspaceFolder}/RouterRS/Cargo.toml", "--workspace"],
      "problemMatcher": ["$rustc"]
    }
  ]
}
